rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(ownProfilePath())
        && get(ownProfilePath()).data.get('active', true) == true
        && get(ownProfilePath()).data.get('role', '') in ['Visit', 'Admin'];
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(ownProfilePath()).data.get('role', '') == 'Admin';
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /procedures/{id} {
      allow get, list: if hasActiveProfile()
        && (isAdmin() || resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }

    match /chapters/{id} {
      allow get, list: if hasActiveProfile()
        && (isAdmin() || resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    match /vehicles/{id} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if isAdmin();
    }
    match /finishes/{id} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if isAdmin();
    }
    match /workstations/{id} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if isAdmin();
    }
    match /models3d/{id} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if isAdmin();
    }
    match /components3d/{id} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if isAdmin();
    }
    match /materials/{id} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if isAdmin();
    }
    match /assets/{id} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
